#!/usr/bin/env python3
"""Crosstalk CLI; symlinks resolve the matching immutable runtime package."""
from pathlib import Path
import hashlib
import json
import os
import sys

SCRIPT = Path(__file__).resolve()
sys.path.insert(0, str(SCRIPT.parent))


def runtime_issues():
    """Diagnose installed code before importing any potentially missing package file."""
    root = Path(os.environ.get('CROSSTALK_CONFIG_DIR', Path.home() / '.claude/crosstalk')).absolute()
    if not SCRIPT.is_relative_to(root / 'releases'):
        return []  # An intact source checkout must remain usable to repair the installation.
    try:
        manifest = json.loads((root / 'installation.json').read_text())
        release = SCRIPT.parents[2]
        if Path(manifest['release_path']) != release:
            return ['runtime_pointer_mismatch']
        files = manifest['release_files']
        if not isinstance(files, dict):
            raise ValueError('invalid release file list')
        required = [rel for rel in files if rel.startswith('assets/scripts/')]
        if 'assets/scripts/crosstalk_lib/cli.py' not in required:
            raise ValueError('missing runtime manifest entries')
        issues = []
        for rel in required:
            path = release / rel
            if Path(rel).is_absolute() or '..' in Path(rel).parts:
                raise ValueError('invalid runtime manifest path')
            if (any(part.is_symlink() for part in (path, *path.parents)) or not path.is_file()
                    or hashlib.sha256(path.read_bytes()).hexdigest() != files[rel]):
                issues.append('runtime_modified_or_missing:' + rel)
        return issues
    except (OSError, ValueError, KeyError, TypeError, AttributeError) as exc:
        return ['installation_manifest_unreadable:' + str(exc)]


def report_damage(issues):
    action = ('Use the intact verified source checkout: '
              'python3 <source>/assets/scripts/crosstalk install --source <source> '
              '--home <installation-home>, with the same CROSSTALK_CONFIG_DIR. '
              'Do not delete the database or damaged release.')
    error = {'code': 'INSTALLATION_INCOMPLETE', 'message': 'Runtime files are missing or changed',
             'retryable': False}
    result = {'error': error, 'saved': False, 'message_id': None, 'next_action': action,
              'installation_health': {'status': 'incomplete', 'issues': issues},
              'issues': [{'code': 'INSTALLATION_INCOMPLETE', 'detail': issue,
                          'next_action': action} for issue in issues]}
    print(json.dumps(result, ensure_ascii=False))
    return 7


def main():
    issues = runtime_issues()
    if issues:
        return report_damage(issues)
    try:
        from crosstalk_lib.cli import main as run
        return run()
    except (ImportError, SyntaxError) as exc:
        return report_damage(['runtime_import_failed:' + str(exc)])

if __name__ == '__main__':
    sys.exit(main())
